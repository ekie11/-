# Скопируйте в .env (cp .env.example .env) и замените все значения CHANGE_ME.
# Файл .env в git не попадает.

# Пароль Postgres. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Флаг Secure у cookie сессии.
# false — пока сайт по HTTP на IP (иначе вход не заработает);
# true  — после перехода на домен с HTTPS.
COOKIE_SECURE=false

# Таймаут одной задачи, секунды.
JOB_TIMEOUT_S=120

# Сколько дней хранить файлы задач до очистки.
FILE_TTL_DAYS=30

# Сеть docker-compose, из которой API доверяет X-Forwarded-For (Caddy и Next).
# Должна совпадать с подсетью в docker-compose.yml; менять не нужно.
TRUSTED_PROXIES=172.28.0.0/16

# Ключ API модели для разбора методички (пусто = функция выключена).
LLM_API_KEY=
# Адрес OpenAI-совместимого API, модель, таймаут (с) и дневные лимиты разбора.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6
LLM_TIMEOUT_S=120
EXTRACT_USER_DAILY=5
EXTRACT_GLOBAL_DAILY=500
