  "rule_labels": {
    "page.size": "Размер страницы",
    "page.margins": "Поля",
    "body.font_name": "Шрифт",
    "body.font_size": "Размер шрифта",
    "body.line_spacing": "Межстрочный интервал",
    "body.first_line_indent": "Абзацный отступ",
    "body.alignment": "Выравнивание текста",
    "headings.section": "Заголовки разделов",
    "headings.structural": "Структурные заголовки",
    "captions.figure": "Подпись рисунка",
    "captions.table": "Заголовок таблицы",
    "page_numbers": "Номер страницы",
    "toc": "Оглавление"
  },
  "fields": [
    {
      "rule": "page.size",
      "path": "format",
      "group": "page",
      "label": "Формат",
      "kind": "fixed",
      "options": [
        {
          "value": "A4",
          "label": "A4"
        }
      ]
    },
    {
      "rule": "page.size",
      "path": "orientation",
      "group": "page",
      "label": "Ориентация",
      "kind": "select",
      "options": [
        {
          "value": "portrait",
          "label": "книжная"
        },
        {
          "value": "landscape",
          "label": "альбомная"
        }
      ]
    },
    {
      "rule": "page.margins",
      "path": "top_mm",
      "group": "page",
      "label": "Верхнее поле",
      "kind": "number",
      "unit": "мм",
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "rule": "page.margins",
      "path": "bottom_mm",
      "group": "page",
      "label": "Нижнее поле",
      "kind": "number",
      "unit": "мм",
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "rule": "page.margins",
      "path": "left_mm",
      "group": "page",
      "label": "Левое поле",
      "kind": "number",
      "unit": "мм",
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "rule": "page.margins",
      "path": "right_mm",
      "group": "page",
      "label": "Правое поле",
      "kind": "number",
      "unit": "мм",
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "rule": "body.font_name",
      "path": "name",
      "group": "body",
      "label": "Гарнитура",
      "kind": "text"
    },
    {
      "rule": "body.font_size",
      "path": "min_pt",
      "group": "body",
      "label": "Минимальный кегль",
      "kind": "number",
      "unit": "пт",
      "min": 8,
      "max": 20,
      "step": 0.5
    },
    {
      "rule": "body.font_size",
      "path": "target_pt",
      "group": "body",
      "label": "Основной кегль",
      "kind": "number",
      "unit": "пт",
      "min": 8,
      "max": 20,
      "step": 0.5
    },
    {
      "rule": "body.line_spacing",
      "path": "multiple",
      "group": "body",
      "label": "Интервал",
      "kind": "number",
      "unit": "×",
      "min": 1,
      "max": 3,
      "step": 0.05
    },
    {
      "rule": "body.first_line_indent",
      "path": "cm",
      "group": "body",
      "label": "Отступ первой строки",
      "kind": "number",
      "unit": "см",
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    {
      "rule": "body.alignment",
      "path": "align",
      "group": "body",
      "label": "Выравнивание",
      "kind": "select",
      "options": [
        {
          "value": "justify",
          "label": "по ширине"
        },
        {
          "value": "left",
          "label": "по левому краю"
        },
        {
          "value": "center",
          "label": "по центру"
        },
        {
          "value": "right",
          "label": "по правому краю"
        }
      ]
    },
    {
      "rule": "headings.section",
      "path": "bold",
      "group": "headings",
      "label": "Требовать жирный шрифт",
      "kind": "bool"
    },
    {
      "rule": "headings.section",
      "path": "align",
      "group": "headings",
      "label": "Выравнивание",
      "kind": "select",
      "options": [
        {
          "value": "justify",
          "label": "по ширине"
        },
        {
          "value": "left",
          "label": "по левому краю"
        },
        {
          "value": "center",
          "label": "по центру"
        },
        {
          "value": "right",
          "label": "по правому краю"
        }
      ]
    },
    {
      "rule": "headings.section",
      "path": "first_line_indent_cm",
      "group": "headings",
      "label": "Отступ первой строки",
      "kind": "number",
      "unit": "см",
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    {
      "rule": "headings.section",
      "path": "trailing_period",
      "group": "headings",
      "label": "Точка в конце заголовка",
      "kind": "fixed",
      "options": [
        {
          "value": "false",
          "label": "не ставится"
        }
      ]
    },
    {
      "rule": "headings.section",
      "path": "page_break_before_level1",
      "group": "headings",
      "label": "Требовать начало раздела с новой страницы",
      "kind": "bool"
    },
    {
      "rule": "headings.structural",
      "path": "bold",
      "group": "structure",
      "label": "Требовать жирный шрифт",
      "kind": "bool"
    },
    {
      "rule": "headings.structural",
      "path": "align",
      "group": "structure",
      "label": "Выравнивание",
      "kind": "select",
      "options": [
        {
          "value": "justify",
          "label": "по ширине"
        },
        {
          "value": "left",
          "label": "по левому краю"
        },
        {
          "value": "center",
          "label": "по центру"
        },
        {
          "value": "right",
          "label": "по правому краю"
        }
      ]
    },
    {
      "rule": "headings.structural",
      "path": "uppercase",
      "group": "structure",
      "label": "Требовать ПРОПИСНЫЕ буквы",
      "kind": "bool"
    },
    {
      "rule": "headings.structural",
      "path": "trailing_period",
      "group": "structure",
      "label": "Точка в конце заголовка",
      "kind": "fixed",
      "options": [
        {
          "value": "false",
          "label": "не ставится"
        }
      ]
    },
    {
      "rule": "headings.structural",
      "path": "page_break_before",
      "group": "structure",
      "label": "Требовать начало с новой страницы",
      "kind": "bool"
