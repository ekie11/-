    {
      "id": "captions",
      "label": "Рисунки и таблицы"
    },
    {
      "id": "formulas",
      "label": "Формулы"
    },
    {
      "id": "lists",
      "label": "Списки"
    },
    {
      "id": "sources",
      "label": "Источники"
    },
    {
      "id": "typography",
      "label": "Типографика"
