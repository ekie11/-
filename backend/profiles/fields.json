          "value": "3",
          "label": "3 уровня"
        }
      ]
    },
    {
      "rule": "toc",
      "path": "hyperlinks",
      "group": "structure",
      "label": "Ссылки в оглавлении",
      "kind": "fixed",
      "options": [
        {
          "value": "true",
          "label": "Да"
        }
      ]
    },
    {
      "rule": "page_numbers",
      "path": "position",
      "group": "numbering",
      "label": "Положение",
      "kind": "select",
      "options": [
        {
          "value": "bottom_center",
          "label": "внизу по центру"
